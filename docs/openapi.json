  "info": {
    "title": "Multi-tenant support platform: backend core",
    "description": "Tenants, staff authentication and roles, end customers. Errors always have the shape `{ statusCode, code, message }`; lists are `{ data, total, skip, take }`.",
    "version": "0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "tenantSlug": {
            "type": "string",
            "example": "acme",
            "description": "The tenant slug chosen at signup"
          },
          "email": {
            "type": "string",
            "example": "owner@acme.com"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "tenantSlug",
          "email",
          "password"
        ]
      },
      "AccessToken": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "Send as `Authorization: Bearer <access_token>`"
          }
        },
        "required": [
          "access_token"
        ]
      },
      "SignupDto": {
        "type": "object",
        "properties": {
          "tenantName": {
            "type": "string",
            "example": "Acme Support"
          },
          "tenantSlug": {
            "type": "string",
            "example": "acme",
            "description": "Login identifier for the tenant (3-40 chars: a-z, 0-9, dashes). Derived from the name when omitted."
          },
          "ownerEmail": {
            "type": "string",
            "example": "owner@acme.com"
          },
          "ownerPassword": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "tenantName",
          "ownerEmail",
          "ownerPassword"
        ]
      },
      "Tenant": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "example": "acme"
          },
          "plan": {
            "type": "string",
            "enum": [
              "free",
              "pro",
              "enterprise"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "trial",
              "active",
              "suspended"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "plan",
          "status",
          "createdAt"
        ]
      },
      "TenantUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "agent"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "tenantId",
          "email",
          "role",
          "createdAt"
        ]
      },
      "SignupResponse": {
        "type": "object",
        "properties": {
          "tenant": {
            "$ref": "#/components/schemas/Tenant"
          },
          "owner": {
            "$ref": "#/components/schemas/TenantUser"
          },
          "access_token": {
            "type": "string",
            "description": "Send as `Authorization: Bearer <access_token>`"
          }
        },
        "required": [
          "tenant",
          "owner",
          "access_token"
        ]
      },
      "PlatformLoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ops@example.com"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UpdateTenantDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "plan": {
            "type": "string",
            "enum": [
              "free",
              "pro",
              "enterprise"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "trial",
              "active",
              "suspended"
            ]
          }
        }
      },
      "CreateTenantUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "agent@acme.com"
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "agent"
            ],
            "default": "agent",
            "description": "Only an owner may create another owner."
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UpdateTenantUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "agent@acme.com"
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "agent"
            ],
            "default": "agent",
            "description": "Only an owner may create another owner."
          }
        }
      },
      "CreateEndCustomerDto": {
        "type": "object",
        "properties": {
          "externalId": {
            "type": "string",
            "example": "web_5f1c...",
            "description": "Unique per tenant (B4)"
          },
          "name": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "externalId"
        ]
      },
      "EndCustomer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "externalId": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "tenantId",
          "externalId",
          "createdAt"
        ]
      },
      "UpdateEndCustomerDto": {
        "type": "object",
        "properties": {
          "externalId": {
