# Copy to `.env` and fill in. Never commit real values. Names only here (F4).

# PostgreSQL. The schema is set in prisma/schema.prisma (tenant_core).
DATABASE_URL=

# Secret used to sign every JWT (staff and platform admin). At least 16 characters, ideally a long
# random string, e.g.  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The app refuses to start without it.
JWT_SECRET=

# Optional. Lifetime of staff tokens (default 1d) and of platform-admin tokens (default 1h).
JWT_EXPIRES_IN=1d
PLATFORM_JWT_EXPIRES_IN=1h

# The dashboard origin allowed by CORS, and the base of emailed links (/accept-invite,
# /reset-password, /verify-email). When empty, no browser origin is allowed. Required when
# NODE_ENV=production.
FRONTEND_URL=http://localhost:5173

# How emailed links (staff invites, password reset, email verification) are delivered. `console`
# (default) logs them: no mail provider is wired yet (H3). `link` also returns them in the API
# response so a developer can click through. The app REFUSES to start with `link` when
# NODE_ENV=production.
MAIL_MODE=console

# Billing job (plan transitions: Starter to Free, grace expiry). "on" (default) sweeps shortly after
# boot and then every BILLING_JOB_INTERVAL_MINUTES (default 60, max 1440) on every instance; a
# Postgres advisory lock lets one instance do the work. Request-time checks stay correct when it is off.
BILLING_JOB=on
BILLING_JOB_INTERVAL_MINUTES=60

# Optional. Default 3000.
PORT=3000

# Only for `npm run platform-admin:create` (creates a platform admin; password >= 12 characters).
# Set them for that one command rather than keeping them in `.env`.
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_PASSWORD=
