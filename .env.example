# Copy to `.env` and fill in. Never commit real values. Names only here (F4).

# PostgreSQL. The schema is set in prisma/schema.prisma (tenant_core).
DATABASE_URL=

# Secret used to sign every JWT (staff and platform admin). At least 16 characters, ideally a long
# random string, e.g.  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The app refuses to start without it.
JWT_SECRET=

# Optional. Lifetime of staff tokens (default 1d) and of platform-admin tokens (default 1h).
JWT_EXPIRES_IN=1d
PLATFORM_JWT_EXPIRES_IN=1h

# The dashboard origin allowed by CORS, and the base of emailed links (/accept-invite,
# /reset-password, /verify-email). When empty, no browser origin is allowed. Required when
# NODE_ENV=production.
FRONTEND_URL=http://localhost:5173

# How emailed links (staff invites, password reset, email verification) are exposed. `console`
# (default) changes nothing; `link` also returns them in the API responses so a developer can
# click through. The app REFUSES to start with `link` when NODE_ENV=production.
MAIL_MODE=console

# Who delivers the emails (H3). `console` (default) only LOGS them (links included): development
# only. `resend` sends them through Resend and needs RESEND_API_KEY. The app REFUSES to start in
# production with `console`. See the "Email" section of the README.
MAIL_PROVIDER=console
# A send-only API key from the Resend dashboard. A secret: put the value here, never in chat or git.
# RESEND_API_KEY=
# Sender address. Default onboarding@resend.dev (Resend's shared test sender, which only delivers to
# the email address of the Resend account itself). Production refuses it: use an address on your
# verified domain.
# MAIL_FROM=onboarding@resend.dev
# Sender name shown to recipients and in email footers. Default "SupportDesk AI" (a working name).
# MAIL_FROM_NAME=SupportDesk AI
# TEST STAGE ONLY: send EVERY email to this one address (the Resend account's own), with the
# intended recipient named in the subject and at the top of the message. Production refuses it.
# MAIL_REDIRECT_TO=
# Optional. Time allowed per attempt when calling Resend, milliseconds (default 5000, 500 to 30000).
# One retry follows a network error, a timeout or a 5xx answer.
# MAIL_TIMEOUT_MS=5000
# Optional (J5). The address that receives the platform's own notifications: an email whenever a tenant
# owner asks for a plan upgrade. When unset the request is only stored and shown to platform admins.
# In the Resend test stage MAIL_REDIRECT_TO still sends it to the redirect address instead.
# PLATFORM_ADMIN_NOTIFY_EMAIL=

# Billing job (plan transitions: Starter to Free, grace expiry). "on" (default) sweeps shortly after
# boot and then every BILLING_JOB_INTERVAL_MINUTES (default 60, max 1440) on every instance; a
# Postgres advisory lock lets one instance do the work. Request-time checks stay correct when it is off.
BILLING_JOB=on
BILLING_JOB_INTERVAL_MINUTES=60

# AI engine (Phase 3). ENGINE_MODE=mock (default outside production) answers chats with an
# in-process mock engine that follows docs/contracts/engine-internal.openapi.yaml, so the widget
# works without the real engine. ENGINE_MODE=http calls the real engine over the private network
# and REQUIRES ENGINE_BASE_URL and INTERNAL_API_TOKEN (the same long random secret the engine is
# configured with, at least 32 characters). The app REFUSES to start in production unless
# ENGINE_MODE=http.
ENGINE_MODE=mock
# ENGINE_BASE_URL=http://engine.internal:4000
# INTERNAL_API_TOKEN=
# The same token also verifies the events the engine pushes to POST /internal/events (signed with
# HMAC-SHA256, see docs/contracts/backend-events.openapi.yaml); without it that route answers 503.
# Optional engine timeouts in milliseconds (D7): until the first answer event, for a whole reply
# stream, and for plain calls. Defaults 10000, 30000, 10000. The first one was 5000 until Phase 5A:
# the engine owner asked for 10 s because his free-tier model needs 3.5 to 10 s to start.
# ENGINE_FIRST_TOKEN_TIMEOUT_MS=10000
# ENGINE_TOTAL_TIMEOUT_MS=30000
# ENGINE_REQUEST_TIMEOUT_MS=10000
# Pause between the mock engine's streamed tokens, milliseconds (default 25).
# MOCK_ENGINE_TOKEN_DELAY_MS=25

# PLAN NUMBERS AND PRICES (L6, Phase 5A). All optional; names only here. Whole numbers in digits (no
# decimals, no signs, no "1e3"); an empty value means "not set". Money is in MINOR units (PKR 25 =
# 2500), minutes are whole minutes. When a variable is SET, the backend writes it into the `plans`
# table at startup (once, idempotent, under a Postgres advisory lock, one log line per change); when
# it is UNSET the value already in the table is kept. The table stays the source of truth that all
# other code reads.
#   - Changing a variable and restarting changes the limits/prices of EVERY tenant on that plan at
#     once (other running instances see it within 30 s). Invoices already recorded are never touched.
#   - Every instance must run with the same values, or the one that starts last wins.
#   - While a variable is set, a hand edit of that one field in the table is undone at the next start.
# Minutes 0 to 1,000,000; money 0 to 2,000,000,000; agents and phone numbers 0 to 10,000. Placeholder values the migration of Phase 5A
# put into the table (to be confirmed against real call costs): Starter 30 minutes in total (its 15
# days), Free 20 a month, Pro 300 a month at PKR 25 (2500) per extra minute, Pro PKR 19,999 a month
# (1999900) or PKR 199,990 a year (19999000).
# PLAN_STARTER_CALL_MINUTES=30
# PLAN_FREE_CALL_MINUTES=20
# PLAN_PRO_CALL_MINUTES=300
# PLAN_PRO_OVERAGE_MINUTE_MINOR=2500
# PLAN_PRO_PRICE_MONTH_MINOR=1999900
# PLAN_PRO_PRICE_YEAR_MINOR=19999000
# Agents and real phone numbers per plan (L7, Phase 5B-1). Placeholders the migration put into the table:
# Starter 1 agent and 0 numbers, Free 1 and 0, Pro 3 and 5 (Enterprise: unlimited, custom per tenant).
# 0 numbers = browser test calls only. Lowering one never deletes anything a tenant already has: it only
# refuses new agents/numbers above the limit.
# PLAN_STARTER_AGENTS=1
# PLAN_FREE_AGENTS=1
# PLAN_PRO_AGENTS=3
# PLAN_STARTER_PHONE_NUMBERS=0
# PLAN_FREE_PHONE_NUMBERS=0
# PLAN_PRO_PHONE_NUMBERS=5

# Escalation retry (Phase 4): when a customer's message hit a failing engine or a plan limit, the
# escalation could not be told to the engine; this job delivers it later (bounded: 10 attempts with a
# growing wait, then the conversation stays flagged). "off" disables the timer on this instance.
ESCALATION_RETRY_JOB=on
ESCALATION_RETRY_INTERVAL_SECONDS=60

# Optional. Default 3000. The AI engine (a separate project) also defaults to 3000: when both run on
# one machine, give one of them another port (this one with PORT, the engine with ENGINE_BASE_URL).
PORT=3000

# Proxies in front of the app, so the audit log's IP and the per-IP rate limits see the real client
# (from X-Forwarded-For) instead of the proxy. Set it to the NUMBER of proxies between the internet
# and this app (1 behind the dashboard's server or one load balancer), or to a comma-separated list
# of their addresses/CIDRs (or loopback, linklocal, uniquelocal). Empty = trust nobody (the default).
# "true" is refused: it would trust a header any client can forge.
# TRUST_PROXY=1

# Only for `npm run platform-admin:create` (creates a platform admin; password >= 12 characters).
# Set them for that one command rather than keeping them in `.env`.
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_PASSWORD=
