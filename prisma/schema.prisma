// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["tenant_core"]
}

model Tenant {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  // DENORMALISED MIRRORS of the subscription (section I): `plan` is the subscription's plan code
  // and `status` is trial | active | suspended | closed. They exist so the auth guard and the
  // admin list need no join. The subscription is the source of truth: only SubscriptionService
  // writes these two columns, in the same transaction as every subscription change. Never read
  // them to decide what a tenant may do (use EntitlementsService), and never write them elsewhere.
  plan          String   @default("free")
  status        String   @default("trial")
  defaultLocale String   @default("en") @map("default_locale")
  createdAt     DateTime @default(now()) @map("created_at")

  tenantUsers          TenantUser[]
  endCustomers         EndCustomer[]
  staffInvites         StaffInvite[]
  auditLogs            AuditLog[]
  subscription         Subscription?
  invoices             Invoice[]
  billingEvents        BillingEvent[]
  dataUseConsents      DataUseConsent[]
  apiKeys              ApiKey[]
  gatewayConversations GatewayConversation[]
  usageDailies         UsageDaily[]
  usageEvents          UsageEvent[]
  notifications        Notification[]
  engineEvents         EngineEvent[]
  streamTickets        StreamTicket[]

  @@map("tenants")
  @@schema("tenant_core")
}

model TenantUser {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  // Always stored trimmed and lower-cased (a CHECK constraint in the database enforces it).
  email             String
  name              String?
  passwordHash      String    @map("password_hash")
  role              String    @default("agent")
  // 'active' | 'disabled'. A disabled user is refused on the next request (JwtStrategy).
  status            String    @default("active")
  emailVerifiedAt   DateTime? @map("email_verified_at")
  // Tokens issued before this instant are rejected (password reset).
  passwordChangedAt DateTime? @map("password_changed_at")
  // Dashboard language; null falls back to tenants.default_locale.
  locale            String?
  createdAt         DateTime  @default(now()) @map("created_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  notifications      Notification[]
  streamTickets      StreamTicket[]

  @@unique([tenantId, email])
  @@map("tenant_user")
  @@schema("tenant_core")
}

model EndCustomer {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  externalId String   @map("external_id")
  name       String?
  metadata   Json?
  locale     String?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  gatewayConversations GatewayConversation[]

  @@unique([tenantId, externalId])
  @@map("end_customers")
  @@schema("tenant_core")
}

model PlatformAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("platform_admins")
  @@schema("tenant_core")
}

/// A pending or finished invitation of a staff member (H1). Only the sha256 of the token is stored.
model StaffInvite {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  email      String
  role       String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  // The inviting user's id. A plain column (no foreign key) so removing that user is not blocked.
  invitedBy  String?   @map("invited_by")
  acceptedAt DateTime? @map("accepted_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, email])
  @@map("staff_invites")
  @@schema("tenant_core")
}

/// Self-service password reset (H2). Rows are removed with their user (ephemeral data).
model PasswordReset {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
  @@schema("tenant_core")
}

/// Email verification links (H4). Rows are removed with their user (ephemeral data).
model EmailVerification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
  @@schema("tenant_core")
}

/// Append-only record of staff and platform-admin actions (H6). A database trigger refuses
/// UPDATE and DELETE. `actorUserId` has no foreign key: it is a tenant_user id, or a
/// platform_admins id when `actorRole` is 'platform_admin'.
model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  actorUserId String?  @map("actor_user_id")
  actorRole   String?  @map("actor_role")
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?  @map("user_agent")
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, action])
  @@index([tenantId, actorUserId])
  @@map("audit_logs")
  @@schema("tenant_core")
}

/// Plan catalogue (I1). Rows are data: prices, durations and entitlements are adjustable without a
/// release. `entitlements` shape: see src/billing/entitlements/entitlements.ts and docs.
model Plan {
  code             String   @id
  name             String
  // 'public' (listed on the pricing page) | 'hidden' (granted, never listed, e.g. Starter)
  visibility       String   @default("public")
  // Integer minor units of `currency`. 0 = free; null = custom quote (Enterprise).
  priceMinor       Int?     @map("price_minor")
  currency         String   @default("PKR")
  // Billing interval of `priceMinor`: 'month' | 'year' | 'none'.
  interval         String   @default("none")
  // Price of a year, for a plan sold both monthly and yearly (Pro). Null = no yearly option.
  yearlyPriceMinor Int?     @map("yearly_price_minor")
  // A plan that ends by itself (Starter: 15). Null = no end.
  durationDays     Int?     @map("duration_days")
  // Where a subscription lands when this plan ends or lapses. Null = it never ends (Free).
  fallbackPlanCode String?  @map("fallback_plan_code")
  entitlements     Json
  // { "<provider>": { "month": "<price id>", "year": "<price id>" } } once a provider exists.
  providerPriceIds Json     @default("{}") @map("provider_price_ids")
  active           Boolean  @default(true)
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
  @@schema("tenant_core")
}

/// One row per tenant: its current plan and billing state (I3). History lives in billing_events,
/// invoices and the audit log. Written only by SubscriptionService.
model Subscription {
  id                     String    @id @default(uuid())
  tenantId               String    @unique @map("tenant_id")
  planCode               String    @map("plan_code")
  // 'active' (includes Starter and Free) | 'past_due' | 'canceled' | 'closed' | 'suspended'
  status                 String    @default("active")
  // Billing interval of the current paid period: 'month' | 'year' | 'none'.
  interval               String    @default("none")
  currentPeriodStart     DateTime  @default(now()) @map("current_period_start")
  // Null = no end (Free).
  currentPeriodEnd       DateTime? @map("current_period_end")
  cancelAtPeriodEnd      Boolean   @default(false) @map("cancel_at_period_end")
  // While past_due: when the grace period ends and the tenant falls back.
  graceEndsAt            DateTime? @map("grace_ends_at")
  // Where an un-suspend returns to.
  statusBeforeSuspension String?   @map("status_before_suspension")
  closedAt               DateTime? @map("closed_at")
  // Per-tenant overrides merged over the plan's entitlements (custom Enterprise contracts).
  entitlementsOverride   Json?     @map("entitlements_override")
  provider               String    @default("manual")
  providerCustomerId     String?   @map("provider_customer_id")
  providerSubscriptionId String?   @map("provider_subscription_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  plan     Plan      @relation(fields: [planCode], references: [code])
  invoices Invoice[]

  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
  @@schema("tenant_core")
}

/// Invoices, amounts in integer minor units (I7). No tax lines yet: the rate, registration and
/// wording need an accountant first. `number` is sequential per year (invoice_sequences).
model Invoice {
  id                String    @id @default(uuid())
  number            String    @unique
  tenantId          String    @map("tenant_id")
  subscriptionId    String    @map("subscription_id")
  planCode          String?   @map("plan_code")
  amountMinor       Int       @map("amount_minor")
  currency          String    @default("PKR")
  // 'draft' | 'open' | 'paid' | 'void'
  status            String
  periodStart       DateTime? @map("period_start")
  periodEnd         DateTime? @map("period_end")
  // 'bank_transfer' | 'cash' | 'cheque' | 'mobile_wallet' | 'other' | 'provider'
  method            String?
  reference         String?
  // The platform admin who recorded it. A plain column (no foreign key), like audit_logs.
  recordedBy        String?   @map("recorded_by")
  providerInvoiceId String?   @map("provider_invoice_id")
  paidAt            DateTime? @map("paid_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("invoices")
  @@schema("tenant_core")
}

/// Gapless invoice numbering per calendar year: one row per year, incremented inside the
/// transaction that creates the invoice (a rollback gives the number back).
model InvoiceSequence {
  year       Int @id
  lastNumber Int @default(0) @map("last_number")

  @@map("invoice_sequences")
  @@schema("tenant_core")
}

/// Append-only log of every normalised billing event (I4). A database trigger refuses UPDATE and
/// DELETE. (provider, provider_event_id) is unique when set, so a replayed webhook is a no-op.
model BillingEvent {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  type            String
  // 'manual' | 'provider' | 'system'
  source          String
  provider        String?
  providerEventId String?  @map("provider_event_id")
  payload         Json
  createdAt       DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([provider, providerEventId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("billing_events")
  @@schema("tenant_core")
}

/// Explicit, revocable, per-tenant consent to use de-identified conversations for our own model
/// training (I11). One row per (tenant, purpose); no row means "off". DEFAULT IS OFF. Nothing in
/// this codebase exports training data: that needs legal review first.
model DataUseConsent {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  purpose      String
  // 'granted' | 'revoked'
  status       String
  termsVersion String    @map("terms_version")
  acceptedBy   String    @map("accepted_by")
  acceptedAt   DateTime  @map("accepted_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, purpose])
  @@map("data_use_consents")
  @@schema("tenant_core")
}

/// Public widget keys and (later) server keys (D8, B4). Only the sha256 of the key is stored; the
/// full key is shown once at creation. A widget key is an identifier, not a secret: it is always
/// checked together with the request Origin against `allowedOrigins`.
model ApiKey {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  // 'widget' | 'server'
  type           String
  name           String
  // First characters of the key, safe to display (for example "wk_AbCd1234").
  keyPrefix      String    @map("key_prefix")
  keyHash        String    @unique @map("key_hash")
  // Exact origins (scheme://host[:port], lower case, no path). Empty = usable from nowhere.
  allowedOrigins String[]  @default([]) @map("allowed_origins")
  lastUsedAt     DateTime? @map("last_used_at")
  revokedAt      DateTime? @map("revoked_at")
  // The staff user who created it. A plain column (no foreign key), like audit_logs.
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([allowedOrigins], type: Gin)
  @@map("api_keys")
  @@schema("tenant_core")
}

/// What the gateway knows about a conversation it started: which end customer it belongs to (so a
/// returning visitor resumes it), whether the AI may answer it, and an escalation the engine could
/// not be told about yet. The conversation itself lives in ai_engine.
model GatewayConversation {
  id                      String    @id @default(uuid())
  tenantId                String    @map("tenant_id")
  // The engine's conversation id (a plain value; the engine owns that table).
  conversationId          String    @map("conversation_id")
  endCustomerId           String    @map("end_customer_id")
  // 'widget' (whatsapp and voice follow in Phase 6)
  channel                 String
  apiKeyId                String?   @map("api_key_id")
  // True when the plan limit was reached when this conversation started: the AI never answers it (I5).
  aiBlocked               Boolean   @default(false) @map("ai_blocked")
  // Why the gateway escalated it (limit_reached, ai_unavailable), once decided.
  escalationReason        String?   @map("escalation_reason")
  // True while the engine has not yet been told about that escalation (it was unreachable).
  escalationPending       Boolean   @default(false) @map("escalation_pending")
  // Phase 4: delivery attempts of that escalation by the retry job (bounded; the flag stays when they run out).
  escalationAttempts      Int       @default(0) @map("escalation_attempts")
  escalationLastAttemptAt DateTime? @map("escalation_last_attempt_at")
  closedAt                DateTime? @map("closed_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  lastActivityAt          DateTime  @default(now()) @map("last_activity_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  endCustomer EndCustomer @relation(fields: [endCustomerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, conversationId])
  @@index([tenantId, endCustomerId, channel, createdAt(sort: Desc)])
  @@index([escalationPending])
  @@map("gateway_conversations")
  @@schema("tenant_core")
}

/// Per-day usage counters of a tenant: the basis of plan limits (B6, I5) and of the usage screen.
/// Written only by UsageService, which increments through usage_events so that recording the same
/// conversation or message twice counts once. `day` is a UTC date.
model UsageDaily {
  tenantId      String   @map("tenant_id")
  day           DateTime @db.Date
  conversations Int      @default(0)
  messages      Int      @default(0)
  tokensIn      Int      @default(0) @map("tokens_in")
  tokensOut     Int      @default(0) @map("tokens_out")
  callMinutes   Int      @default(0) @map("call_minutes")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, day])
  @@map("usage_daily")
  @@schema("tenant_core")
}

/// Dedupe ledger for usage_daily: one row per counted conversation or message (`kind`, `refId` =
/// the engine's id). Inserting the same (tenant, kind, ref) twice is a no-op, so replays, retries and
/// the later `usage.recorded` event cannot double count.
model UsageEvent {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  // 'conversation' | 'message'
  kind      String
  refId     String   @map("ref_id")
  day       DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, kind, refId])
  @@index([tenantId, day])
  @@map("usage_events")
  @@schema("tenant_core")
}

// In-app notification (H5, Phase 4): one row per recipient. The text is not stored: the frontend
// renders `notification.<type>.title` / `.body` of the `notifications` namespace with `params`.
// Removed with the user (cascade) and purged after 90 days.
model Notification {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  userId    String    @map("user_id")
  // e.g. 'conversation.escalated', 'billing.trial_ending' (documented in docs/architecture.md)
  type      String
  params    Json      @default("{}")
  // App-relative path the notification opens, e.g. '/conversations/<id>'.
  link      String?
  // Makes a reminder idempotent: one row per (recipient, dedupe_key). Null for event-driven rows.
  dedupeKey String?   @map("dedupe_key")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  user   TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, dedupeKey])
  @@index([tenantId, userId, readAt, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("notifications")
  @@schema("tenant_core")
}

// Inbox of the events the AI engine pushed (POST /internal/events, D5): the unique (tenant, event id)
// makes delivery idempotent. Only ids and types are kept, never message text. Purged after 30 days.
model EngineEvent {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  // The engine's id of the event.
  eventId    String   @map("event_id")
  type       String
  occurredAt DateTime @map("occurred_at")
  receivedAt DateTime @default(now()) @map("received_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, eventId])
  @@index([receivedAt])
  @@map("engine_events")
  @@schema("tenant_core")
}

// Single-use 30-second ticket that lets a browser open the dashboard event stream with EventSource
// (which cannot send an Authorization header). Only the sha256 of the ticket is stored.
model StreamTicket {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  user   TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("stream_tickets")
  @@schema("tenant_core")
}
